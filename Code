-- 1. Display all patients
SELECT * FROM Patient;



-- 2. Show all appointments for a specific doctor
SELECT P.Name AS Patient_Name, A.Date, A.Time, A.Status
FROM Appointment A
JOIN Patient P ON A.Patient_ID = P.Patient_ID
WHERE A.Doctor_ID = 101;

-- 3. Count total appointments for each doctor
SELECT Doctor_ID, COUNT(*) AS Total_Appointments
FROM Appointment
GROUP BY Doctor_ID
HAVING COUNT(*) > 0;

-- 4. Display patients with their reports and doctor names
SELECT P.Name AS Patient, D.Name AS Doctor, R.Diagnosis, R.Prescription
FROM Medical_Report R
JOIN Patient P ON R.Patient_ID = P.Patient_ID
JOIN Doctor D ON R.Doctor_ID = D.Doctor_ID;

-- 5. Create a view for patient details with medical reports
CREATE VIEW Patient__Reports AS
SELECT P.Name, D.Name AS Doctor, R.Diagnosis, R.Prescription
FROM Patient P
JOIN Medical_Report R ON P.Patient_ID = R.Patient_ID
JOIN Doctor D ON D.Doctor_ID = R.Doctor_ID;

SELECT * FROM Patient__Reports;
